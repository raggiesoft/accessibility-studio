<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>a11y-studio-cli</AssemblyName>
    <RootNamespace>AccessibilityStudio.Cli</RootNamespace>
    <Version>1.0.0</Version>
    <Company>RaggieSoft Media</Company>
    <Product>RaggieSoft Accessibility Studio CLI</Product>
    <Authors>Michael P. Ragsdale</Authors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AccessibilityStudio.Core\AccessibilityStudio.Core.csproj" />
    <ProjectReference Include="..\AccessibilityStudio.Reporting\AccessibilityStudio.Reporting.csproj" />
  </ItemGroup>
</Project>
