<!--
================================================================================
FILE: AccessibilityStudio.WinForms.csproj
PROJECT: RaggieSoft Accessibility Studio (Enterprise C# .NET 10 WinForms IDE)
LICENSE: MIT License
================================================================================
PLAIN-ENGLISH OVERVIEW (100-LEVEL WINFORMS PROJECT GUIDE):
  What is this file?
    Configures our flagship Windows desktop IDE (`AccessibilityStudio.exe`):
      - `UseWindowsForms=true` + `TargetFramework=net10.0-windows`: Enables .NET 10
        Windows Forms with native `SystemColorMode.System` Dark/Light Mode and
        Per-Monitor V2 High-DPI rendering.
      - `EnableWindowsTargeting=true`: Lets `dotnet build` compile and type-check
        100% of our WinForms C# code on macOS and Linux CI runners as well as in
        Visual Studio 2026 on Windows 11 Pro!
      - `Microsoft.Web.WebView2`: Hosts both our Monaco Syntax/Diff Code Editor
        and our Live Chromium Visual DOM & Emulation Inspector inside native
        WinForms docking/splitter panels.
================================================================================
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);WFO5001;MSB3277</NoWarn>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>AccessibilityStudio</AssemblyName>
    <RootNamespace>AccessibilityStudio.WinForms</RootNamespace>
    <!-- Emit native Windows PE32+ executable (`win-x64` or `win-arm64`) into `build\INSTALLDIR\<Config>\<arch>\StudioIDE\` -->
    <RuntimeIdentifier>$(TargetWinRid)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <OutputPath>..\..\build\INSTALLDIR\$(Configuration)\$(TargetArchFolder)\StudioIDE\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>RaggieSoft Media</Company>
    <Product>RaggieSoft Accessibility Studio</Product>
    <Authors>Michael P. Ragsdale</Authors>
    <Copyright>Copyright © 2026 Michael P. Ragsdale (MIT License)</Copyright>
    <ApplicationIcon>Assets\AccessibilityStudio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessibilityStudio.Core\AccessibilityStudio.Core.csproj" />
    <ProjectReference Include="..\AccessibilityStudio.Reporting\AccessibilityStudio.Reporting.csproj" />
    <!-- Build-order dependencies so building WinForms (`F5` / `Ctrl+Shift+B`) populates sibling `CLI\` and `HelpViewer\` folders without copying their files into `StudioIDE\` -->
    <ProjectReference Include="..\AccessibilityStudio.Cli\AccessibilityStudio.Cli.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      ExcludeAssets="all"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\RaggieSoft.HelpViewer\RaggieSoft.HelpViewer.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      ExcludeAssets="all"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AccessibilityStudio.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AccessibilityStudio.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppSplashBackdrop.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppSplash.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Post-Build Dual-Architecture (`x64` + `arm64`) `[INSTALLDIR]` Feature Tree Assembly:
    1. Populates `HelpModules\`, `Samples\`, and `Legal\` for the active architecture (`x64` or `arm64`).
    2. Automatically builds the companion CPU architecture (`ARM64` when `x64` is selected,
       or `x64` when `ARM64` is selected) so EVERY Visual Studio build outputs BOTH native
       AMD64 (`x64\`) and native AArch64 (`arm64\`) `[INSTALLDIR]` trees!
  -->
  <Target Name="StageInstallDirFeatures" AfterTargets="Build">
    <PropertyGroup>
      <InstallDirRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../build/INSTALLDIR/$(Configuration)/$(TargetArchFolder)'))</InstallDirRoot>
      <RepoRootDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</RepoRootDir>
      <HelpModuleOutDir>$([System.IO.Path]::Combine('$(InstallDirRoot)', 'HelpModules', 'raggiesoft.accessibility-studio'))</HelpModuleOutDir>
      <SamplesOutDir>$([System.IO.Path]::Combine('$(InstallDirRoot)', 'Samples'))</SamplesOutDir>
      <LegalOutDir>$([System.IO.Path]::Combine('$(InstallDirRoot)', 'Legal'))</LegalOutDir>
    </PropertyGroup>

    <ItemGroup>
      <SampleFixtures Include="$(RepoRootDir)/samples/*.*" />
      <LegalDocs Include="$(RepoRootDir)/LICENSE;$(RepoRootDir)/THIRD-PARTY-NOTICES.txt;$(RepoRootDir)/README.md" />
    </ItemGroup>

    <MakeDir Directories="$(HelpModuleOutDir);$(SamplesOutDir);$(LegalOutDir)" />
    <Copy SourceFiles="@(SampleFixtures)" DestinationFolder="$(SamplesOutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LegalDocs)" DestinationFolder="$(LegalOutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BuildCompanionArchitectureInstallDir"
          AfterTargets="StageInstallDirFeatures"
          Condition="'$(IsCompanionArchBuild)' != 'true'">
    <PropertyGroup>
      <CompanionPlatform Condition="'$(Platform)' == 'ARM64'">x64</CompanionPlatform>
      <CompanionPlatform Condition="'$(Platform)' != 'ARM64'">ARM64</CompanionPlatform>
      <HostArchSlug Condition="$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString()) == 'Arm64'">arm64</HostArchSlug>
      <HostArchSlug Condition="'$(HostArchSlug)' == ''">x64</HostArchSlug>
      <GuestArchSlug Condition="'$(HostArchSlug)' == 'arm64'">x64</GuestArchSlug>
      <GuestArchSlug Condition="'$(HostArchSlug)' != 'arm64'">arm64</GuestArchSlug>
      <ConfigInstallRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../build/INSTALLDIR/$(Configuration)'))</ConfigInstallRoot>
      <HostCliDll>$([System.IO.Path]::Combine('$(ConfigInstallRoot)', '$(HostArchSlug)', 'CLI', 'a11y-studio-cli.dll'))</HostCliDll>
      <HostCliRuntimeConfig>$([System.IO.Path]::Combine('$(ConfigInstallRoot)', '$(HostArchSlug)', 'CLI', 'a11y-studio-cli.runtimeconfig.json'))</HostCliRuntimeConfig>
      <HostHelpModuleDir>$([System.IO.Path]::Combine('$(ConfigInstallRoot)', '$(HostArchSlug)', 'HelpModules', 'raggiesoft.accessibility-studio'))</HostHelpModuleDir>
      <GuestHelpModuleDir>$([System.IO.Path]::Combine('$(ConfigInstallRoot)', '$(GuestArchSlug)', 'HelpModules', 'raggiesoft.accessibility-studio'))</GuestHelpModuleDir>
      <DotNetHostExe Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</DotNetHostExe>
      <DotNetHostExe Condition="'$(DotNetHostExe)' == ''">dotnet</DotNetHostExe>
    </PropertyGroup>

    <Message Importance="High" Text="⚙️ [Dual-Arch INSTALLDIR] Building companion $(CompanionPlatform) [INSTALLDIR] feature tree..." />

    <!-- Clear solution context (`BuildingSolutionFile=false`) so `Core` and `Reporting` also compile natively for `$(CompanionPlatform)` with 0 CS8012 warnings! -->
    <MSBuild Projects="..\AccessibilityStudio.Core\AccessibilityStudio.Core.csproj;..\AccessibilityStudio.Reporting\AccessibilityStudio.Reporting.csproj;..\AccessibilityStudio.Cli\AccessibilityStudio.Cli.csproj;..\RaggieSoft.HelpViewer\RaggieSoft.HelpViewer.csproj;$(MSBuildProjectFullPath)"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(CompanionPlatform);BuildingSolutionFile=false;CurrentSolutionConfigurationContents=;IsCompanionArchBuild=true" />

    <!-- Export Help Module once using the host-native CLI (`arm64` on Apple Silicon / Windows on ARM, `x64` on Intel/AMD) and mirror to the second architecture -->
    <Exec Command="&quot;$(DotNetHostExe)&quot; exec --runtimeconfig &quot;$(HostCliRuntimeConfig)&quot; &quot;$(HostCliDll)&quot; export-help &quot;$(HostHelpModuleDir)&quot;" />
    <ItemGroup>
      <GeneratedHelpFiles Include="$(HostHelpModuleDir)/*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(GeneratedHelpFiles)" DestinationFolder="$(GuestHelpModuleDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
